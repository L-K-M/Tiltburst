vertex main0_out main0(main0_in in [[stage_in]], constant type_ViewUniforms& ViewUniforms [[buffer(0)]])
{
    main0_out out = {};
    float _50 = cos(in.in_var_TEXCOORD2.x);
    float _51 = sin(in.in_var_TEXCOORD2.x);
    float2 _53 = in.in_var_TEXCOORD0 * in.in_var_TEXCOORD1.zw;
    float _55 = _53.x;
    float _57 = _53.y;
    out.gl_Position = ViewUniforms.u_to_clip * float4(in.in_var_TEXCOORD1.xy + float2((_55 * _50) - (_57 * _51), (_55 * _51) + (_57 * _50)), 0.0, 1.0);
    out.out_var_TEXCOORD0 = _53;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD3;
    out.out_var_TEXCOORD3 = in.in_var_TEXCOORD4;
