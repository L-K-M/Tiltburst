    // bass, sparse shimmer.
    "attract": {
      "bpm": 92, "ticks_per_row": 12,
      "patterns": {
        "A": {
          "pulse1": ["E-5 nd_lead 9 V3,3", "---", "---", "---",
                     "C-5 . . V3,3", "---", "---", "---",
                     "D-5 . . V3,3", "---", "---", "---",
                     "B-4 . . V3,3", "---", "---", "OFF"],
          "pulse2": ["---", "---", "---", "---",
                     "A-4 nd_stab 6", "---", "---", "---",
                     "---", "---", "---", "---",
                     "G-4 nd_stab 6", "---", "---", "---"],
          "wide":   ["A-2 nd_bass 11", "---", "---", "---",
                     "F-2 . 11", "---", "---", "---",
                     "C-3 . 11", "---", "---", "---",
                     "G-2 . 11", "---", "---", "---"],
          "noise":  ["---", "---", "C-6 nd_hat 4", "---",
                     "---", "---", "C-6 . 4", "---",
                     "---", "---", "C-6 . 4", "---",
                     "---", "---", "C-6 . 4", "---"]
