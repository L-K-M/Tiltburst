      "patterns": {
        "A": {
          "pulse1": ["E-5 nd_lead 12", "A-5", "E-5", "A-5",
                     "E-5", "A-5", "E-5", "A-5",
                     "D-5", "A-5", "D-5", "A-5",
                     "D-5", "A-5", "D-5", "OFF"],
          "pulse2": ["E-4 nd_stab 10", "B-4", "E-4", "B-4",
