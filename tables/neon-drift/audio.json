                     "C-4 . . A047", "---", "C-4 . . A047", "---"],
          "wide":   ["D-2 nd_bass 12", "D-2", "D-3", "D-2",
                     "D-2", "D-3", "D-2", "D-3",
                     "C-2", "C-2", "C-3", "C-2",
                     "C-2", "C-3", "C-2", "C-3"],
          "noise":  ["C-2 nd_kit 15", "C-6 . 5", "A-4 . 12", "C-6 . 5",
                     "C-2 . 15", "C-6 . 5", "A-4 . 12", "C-6 . 5",
                     "C-2 . 15", "C-6 . 5", "A-4 . 12", "C-6 . 5",
