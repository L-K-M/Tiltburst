      "patterns": {
        "A": {
          "pulse1": ["A-4 nd_lead 11", "A-4", "C-5", "A-4",
                     "E-5", "C-5", "A-4", "C-5",
                     "F-4", "F-4", "A-4", "F-4",
                     "C-5", "A-4", "F-4", "OFF"],
          "pulse2": ["A-3 nd_stab 9 A037", "A-3 . . A037", "A-3 . . A037",
