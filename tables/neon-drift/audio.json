                     "C-5", "---", "A-4", "OFF"],
          "pulse2": ["---", "A-4 nd_stab 8 A037", "---", "A-4 . . A037",
                     "---", "A-4 . . A037", "---", "A-4 . . A037",
                     "---", "F-4 . . A047", "---", "F-4 . . A047",
                     "---", "F-4 . . A047", "---", "F-4 . . A047"],
          "wide":   ["A-2 nd_bass 12", "A-2", "A-3", "A-2",
                     "A-2", "A-3", "A-2", "A-3",
