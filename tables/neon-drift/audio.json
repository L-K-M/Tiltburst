{
  // neon-drift — full audio pack. Canon: PLAN.md 5.8, 15-launch-tables.md
  // §1.6. Patches: the seven table deltas (unlisted events keep the
  // built-ins, 12-audio.md §6.2); instruments for the six reserved song
  // states (§9): attract 92 BPM neon ballad, main 118 synthwave groove,
  // mode 128 driving, multiball 140 double-time, wizard 150 peak, and a
  // 4-bar engine-down game_over sting.
  "patches": {
    // ---- §1.6 deltas ----
    "nd_shift_clack":  { "wave": "square", "base_freq": 0.09, "punch": 0.3,
                         "sustain": 0.02, "decay": 0.12, "volume_db": -2,
                         "priority": 6 },
    "nd_horn":         { "wave": "saw", "base_freq": 0.32, "sustain": 0.06,
                         "decay": 0.20, "volume_db": -3, "priority": 6 },
    "nd_tach":         { "wave": "square", "base_freq": 0.50, "freq_slide": 0.4,
                         "sustain": 0.0, "decay": 0.08, "volume_db": -2,
                         "priority": 5 },
    "nd_drift_skid":   { "wave": "noise", "base_freq": 0.30, "sustain": 0.45,
                         "decay": 0.25, "lpf_cutoff": 0.40, "hpf_cutoff": 0.05,
                         "volume_db": -4, "priority": 6 },
    "nd_boost":        { "wave": "noise", "base_freq": 0.25, "freq_slide": 0.8,
                         "sustain": 0.25, "decay": 0.15, "hpf_cutoff": 0.10,
                         "volume_db": -2, "priority": 7 },
    "nd_gearshift":    { "wave": "saw", "base_freq": 0.20, "freq_slide": 0.9,
                         "punch": 0.4, "sustain": 0.30, "decay": 0.20,
                         "volume_db": -2, "priority": 8 },
    "nd_nitro_hit":    { "wave": "saw", "base_freq": 0.40, "freq_slide": -0.7,
                         "punch": 0.6, "sustain": 0.15, "decay": 0.30,
                         "volume_db": 1, "priority": 9 },
    // ---- tracker instruments (§8.1; shared across the six songs) ----
    "nd_lead":  { "wave": "square", "duty": 0.25, "attack": 0.02, "sustain": 0.4,
                  "decay": 0.25, "volume_db": -3 },
    "nd_stab":  { "wave": "square", "duty": 0.5, "sustain": 0.0, "decay": 0.12,
                  "volume_db": -6 },
    "nd_bass":  { "wave": "saw", "sustain": 0.5, "decay": 0.2, "volume_db": -2 },
    "nd_kit":   { "wave": "noise", "sustain": 0, "decay": 0.18, "volume_db": -4 },
    "nd_hat":   { "wave": "noise", "sustain": 0, "decay": 0.06, "volume_db": -10 }
  },
  "map": {
    "flipper": "nd_shift_clack",
    "pop_bumper": "nd_horn",
    "spinner": "nd_tach",
    "magnet": "nd_drift_skid",
    "ramp_made": "nd_boost"
  },
  "songs": {
