                     "D-5 . . V3,5", "---", "B-4", "---",
                     "G-4", "---", "A-4", "OFF"],
          "pulse2": ["---", "C-5 nd_stab 8 A047", "---", "C-5 . . A047",
                     "---", "C-5 . . A047", "---", "C-5 . . A047",
                     "---", "G-4 . . A047", "---", "G-4 . . A047",
