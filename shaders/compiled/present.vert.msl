#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_ViewUniforms
{
    float4x4 u_to_clip;
    float2 u_target_px;
    float u_ppm;
    float u_time;
};

struct main0_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float4 gl_Position [[position]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
};

vertex main0_out main0(main0_in in [[stage_in]], constant type_ViewUniforms& ViewUniforms [[buffer(0)]])
{
    main0_out out = {};
    out.gl_Position = ViewUniforms.u_to_clip * float4(in.in_var_TEXCOORD0, 0.0, 1.0);
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    return out;
}

